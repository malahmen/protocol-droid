# Copy to .env (docker compose reads it automatically).
# Host paths for source documents and converted output (mounted into the stack).
MARKER_INPUT=./input
MARKER_OUTPUT=./output

# API exposure. Without a token the API is unauthenticated, so it binds to
# localhost only. To reach it from other hosts set BOTH a token and API_BIND=0.0.0.0;
# callers then send `Authorization: Bearer <token>`.
PROTOCOL_DROID_TOKEN=
API_BIND=127.0.0.1

# Seconds a job's result/failure stays in Redis (default 24h).
RESULT_TTL=86400

# Only for use_llm=true: marker's Gemini service reads this name.
GOOGLE_API_KEY=
