# markitdown worker image - the light converter in an image of its own.
#
#   podman build -f Dockerfile.markitdown -t markitdown-service:latest .
#
# protocol (the conversion API) gives every converter its own queue so a light
# job never waits behind a heavy one. This is the same split for images
# (Kamino item 76): the marker image carries torch and llama-server, 6.8 GB;
# markitdown converts DOCX, PPTX, XLSX and the rest with none of it, so it gets
# a small image of its own rather than riding in marker's.
#
# It holds the converter and the port protocol calls (markitdown_tasks.
# convert_bytes), not a worker loop: the worker that consumes the queue is
# protocol's. The default command prints what is installed and exits.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    HOME=/home/app

WORKDIR /app

COPY requirements-markitdown.txt .
RUN pip install --no-cache-dir -r requirements-markitdown.txt

COPY port.py provenance.py markitdown_tasks.py ./

# Unprivileged, as in the marker image. Nothing is written outside the temp
# folder each conversion makes and removes.
RUN useradd --system --uid 1000 --create-home --shell /usr/sbin/nologin app
USER app

CMD ["python", "-m", "markitdown_tasks"]
